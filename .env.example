PORT=3000
NODE_ENV=production
# Use a mounted or otherwise persistent directory in production.
# The Docker image overrides this with /data/barons.db.
DATABASE_PATH=./data/barons.db

# Required security settings. Generate JWT_SECRET with a cryptographically secure
# random generator; it must be at least 32 characters and must never be committed.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Meta / Instagram Webhook Configuration
FB_VERIFY_TOKEN=your_verify_token
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
# Required to validate Meta's X-Hub-Signature-256 webhook signature.
INSTAGRAM_APP_SECRET=your_meta_app_secret

# Per-merchant Instagram OAuth connection (Instagram Login)
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_OAUTH_REDIRECT_URI=https://your-domain.example/api/integrations/instagram/callback

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional, one-time master administrator bootstrap. Set to true only for the
# first startup of a new database, then set it back to false.
BOOTSTRAP_MASTER_ADMIN=false
MASTER_ADMIN_NAME=Platform Administrator
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# Restrict this in production, for example: https://panel.example.com
CORS_ORIGINS=https://your-domain.example
